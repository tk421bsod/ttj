<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/img/grc_logo_green.png" type="image/png">
   
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/4.1.1/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/js/bootstrap.min.js"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.datatables.net/responsive/4.1.1/css/responsive.dataTables.min.css" rel="stylesheet">

    <title>Home | Trades Job Board</title>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-bg">
        <div class="container-fluid navbar-container d-flex flex-nowrap">
            <a class="navbar-brand d-flex flex-column align-items-center justify-content-start nav-link" href="/">
                <img src="/img/grc_logo_white.png" width="97" alt="GRC Logo">
                Trades Job Board
            </a>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link nav-link-active" href="/">All Jobs</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/add-job">Add Job</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="https://greenriver.edu/students/academics/areas-of-interest/program-maps/trades-industrial-tech-aviation-natural-resources/index.html" target="_blank">GRC Trades Page</a>
                </li>
            </ul>
        </div>
    </nav>
    <div class="container-fluid">
        <table id="job-table" class="display">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Trade</th>
                    <th>Company</th>
                    <th>Location</th>
                    <th>Posting Date</th>
                    <th>Close Date</th>
                    <th>Employment Type</th>
                    <th>Internship</th>
                    <th>Paid</th>
                    <th>Compensation</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% jobs.forEach( job => { %>
                    <tr>
                        <td><%= job.title %></td>
                        <td><%= job.trade %></td>
                        <td><%= job.company %></td>
                        <td><%= job.location %></td>
                        <td><%= job.post_date %></td>
                        <td><%= job.close_date %></td>
                        <td><%= job.type %></td>
                        <td><%= job.internship ? 'Yes' : 'No' %></td>
                        <td><%= job.is_paid ? 'Yes' : 'No' %></td>
                        <td><%= job.compensation %></td>
                        <td><a href='/view-job/<%= job.uuid %>'>View</a></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
    <script>
    function render_clean_dt(data, type, row) {
        if (!data) return '';

        const date = new Date(data);

        if (type === 'sort' || type === 'type') {
            return date.getTime();
        }

        if (type === 'display' || type === 'filter') {
            return date.toLocaleDateString('en-US', { timeZone: 'UTC' });
        }
        return data;
    }

    new DataTable('#job-table', {
            responsive: true,
            order: [[4, 'desc']], // order setting ensures that table will show the newest jobs first
            columns: [
                null,
                null,
                null,
                null,
                {render: render_clean_dt},
                {render: render_clean_dt},
                null,
                null,
                null,
                null,
                null
            ]
        });
</script>
</body>
</html>